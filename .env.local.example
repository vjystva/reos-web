# reos-backend (NestJS) base URL — server-only, never exposed to the browser
REOS_API_BASE_URL=http://localhost:3001

# reos-ai-service (FastAPI) — server-only. Powers the internal AI assistant.
AI_SERVICE_BASE_URL=http://localhost:8001
# Shared BFF -> ai-service secret. MUST match reos-ai-service's actual
# SERVICE_KEY value (not its placeholder default).
AI_SERVICE_KEY=change-me-to-match-ai-service-SERVICE_KEY
